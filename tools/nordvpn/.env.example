# NordVPN OpenVPN *service* credentials — NOT your account password.
# Generate them at: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
#
# Put this file at ~/.config/toolbelt/nordvpn.env and chmod 600 it (the tool refuses a
# group/world-readable file). Or use the Keychain instead:
#   security add-generic-password -s toolbelt-nordvpn -a NORD_USER -w <username>
#   security add-generic-password -s toolbelt-nordvpn -a NORD_PASS -w <password>
# A copy at tools/nordvpn/.env still works but is deprecated and warned on.
NORD_USER=your_service_username
NORD_PASS=your_service_password
