#!/bin/sh
# Secrets gate: refuse any staged file that detect-secrets flags — the last line between a pasted
# token and a history that keeps it forever. Requires: pipx install detect-secrets.
# A .secrets.baseline at the repo root (detect-secrets scan > .secrets.baseline) whitelists audited
# false positives; without one every finding blocks.
if ! command -v detect-secrets-hook >/dev/null 2>&1; then
  echo "pre-commit: detect-secrets-hook not found (pipx install detect-secrets). Refusing to commit unscanned." >&2
  exit 1
fi
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
if [ -f .secrets.baseline ]; then
  # shellcheck disable=SC2086
  detect-secrets-hook --baseline .secrets.baseline $files
else
  # shellcheck disable=SC2086
  detect-secrets-hook $files
fi
